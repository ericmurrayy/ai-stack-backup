    {
      "parameters": {
        "jsCode": "// Create or update customer, location, and job\nconst action = $input.first().json;\nconst payload = action.payload;\nconst ownerId = $env.SUPABASE_OWNER_ID;\n\n// Prepare customer data\nconst customerData = {\n  owner_id: ownerId,\n  name: payload.customer?.name || 'Unknown Customer',\n  phone: payload.customer?.phone,\n  email: payload.customer?.email\n};\n\n// Prepare location data\nconst locationData = payload.location ? {\n  owner_id: ownerId,\n  address1: payload.location.address1,\n  city: payload.location.city,\n  state: payload.location.state,\n  postal_code: payload.location.postal_code\n} : null;\n\n// Prepare job data\nconst jobData = {\n  owner_id: ownerId,\n  title: payload.title || 'New Service Request',\n  service_type: payload.service_type,\n  problem_description: payload.problem_description,\n  scheduled_start: payload.scheduled_start,\n  scheduled_end: payload.scheduled_end,\n  status: 'scheduled'\n};\n\nreturn [{\n  json: {\n    action_id: action.id,\n    customer: customerData,\n    location: locationData,\n    job: jobData\n  }\n}];"
      },
      "id": "prepare-job-data",
      "name": "Prepare Job Data",
