{
  "name": "06 - Review Request",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "review-request",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Review Request Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "review-request"
    },
    {
      "parameters": {
        "operation": "select",
        "schema": "public",
        "table": "jobs",
        "filterType": "string",
        "filterString": "id=eq.{{ $json.job_id }}",
        "options": {
          "select": "*, customer:customers(*)"
        }
      },
      "id": "fetch-job",
      "name": "Fetch Job",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-creds",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true},
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {"type": "string", "operation": "equals"}
            }
          ]
        }
      },
      "id": "is-completed",
      "name": "Is Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const job = $input.first().json;\nconst customer = job.customer;\nconst reviewUrl = $env.REVIEW_URL || 'https://g.page/r/YOUR_GOOGLE_REVIEW_LINK';\n\nif (!customer?.phone) {\n  throw new Error('Customer has no phone number');\n}\n\nconst message = `Hi ${customer.name}! Thank you for choosing Murray's Garage Door Service. We'd love to hear about your experience! Please leave us a review: ${reviewUrl}`;\n\nreturn [{\n  json: {\n    to_phone: customer.phone,\n    message: message,\n    job_id: job.id\n  }\n}];"
      },
      "id": "format-message",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openphone.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{ $env.QUO_PHONE_NUMBER_ID }}\",\n  \"to\": [\"{{ $json.to_phone }}\"],\n  \"body\": \"{{ $json.message }}\"\n}",
        "options": {}
      },
      "id": "send-sms",
      "name": "Send Review Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "quo-api-creds",
          "name": "Quo API"
        }
      }
    }
  ],
  "connections": {
    "Review Request Trigger": {
      "main": [[{"node": "Fetch Job", "type": "main", "index": 0}]]
    },
    "Fetch Job": {
      "main": [[{"node": "Is Completed?", "type": "main", "index": 0}]]
    },
    "Is Completed?": {
      "main": [
        [{"node": "Format Message", "type": "main", "index": 0}],
        []
      ]
    },
    "Format Message": {
      "main": [[{"node": "Send Review Request", "type": "main", "index": 0}]]
    }
  },
  "settings": {"executionOrder": "v1"},
  "tags": [{"name": "Murray FSM"}]
}
