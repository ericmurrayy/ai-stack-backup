# Murray's FSM Web - Environment Variables
# ==========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL (for redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n Webhooks
N8N_APPROVAL_EXECUTOR_WEBHOOK_URL=https://your-n8n.com/webhook/approval-executor
N8N_WEBHOOK_SECRET=your-webhook-signing-secret

# Email Provider (resend | sendgrid | postmark)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_your-resend-api-key
EMAIL_FROM_ADDRESS=noreply@murraysfsm.com
EMAIL_FROM_NAME=Murray's FSM
EMAIL_REPLY_TO=support@murraysfsm.com

# SMS Provider (twilio | openphone)
SMS_PROVIDER=twilio

# Twilio (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# OpenPhone (required when SMS_PROVIDER=openphone)
OPENPHONE_API_KEY=your-openphone-api-key
OPENPHONE_PHONE_NUMBER_ID=your-openphone-phone-number-id

# Development
# SKIP_AUTH=true  # Skip auth redirect in development (uncomment to enable)
# LOG_LEVEL=debug  # Logging level (debug | info | warn | error)
