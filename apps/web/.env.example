# Murray's FSM Web - Environment Variables
# ==========================================
# Copy this file to .env and fill in the values.
# Variables marked REQUIRED will crash the server if missing.
# Variables marked OPTIONAL degrade gracefully when absent.

# ── REQUIRED: Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── REQUIRED: Owner ID ─────────────────────────────────────────────────
# Supabase user UUID — used as owner_id for webhook-created records
DEFAULT_OWNER_ID=your-supabase-user-uuid

# ── OPTIONAL: Site URL ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OPTIONAL: AI ───────────────────────────────────────────────────────
# Claude API key for call transcript analysis and spam detection
ANTHROPIC_API_KEY=
# OpenAI key for embeddings (used by some features)
OPENAI_API_KEY=
# Local Ollama URL (defaults to http://localhost:11434)
# NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# ── OPTIONAL: Payments (Stripe) ───────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── OPTIONAL: Phone Integration ───────────────────────────────────────
OPENPHONE_API_KEY=
RETELL_AGENT_ID=
RETELL_WEBHOOK_SECRET=

# ── OPTIONAL: n8n Webhooks ─────────────────────────────────────────────
N8N_APPROVAL_EXECUTOR_WEBHOOK_URL=https://your-n8n.com/webhook/approval-executor

# ── OPTIONAL: Webhook & Cron Secrets ───────────────────────────────────
# WEBHOOK_SECRET and CRON_SECRET auto-generate if not set (works out of the box).
# Set them explicitly for stable values across deploys/restarts.
# BESIDE_WEBHOOK_SECRET MUST match the signing secret from your Beside dashboard.
WEBHOOK_SECRET=
BESIDE_WEBHOOK_SECRET=
CRON_SECRET=

# ── OPTIONAL: Zapier Integration ──────────────────────────────────────
ZAPIER_WEBHOOK_SECRET=
ZAPIER_OUTGOING_WEBHOOK_URL=

# ── OPTIONAL: Job Completion Hooks ─────────────────────────────────────
INTERNAL_WEBHOOK_SECRET=
AUTO_SEND_INVOICE=false
AUTO_SEND_REVIEW=false

# ── OPTIONAL: Business Info (used in PDF invoices) ─────────────────────
BUSINESS_NAME=Murray's Garage Door Service
BUSINESS_ADDRESS1=
BUSINESS_CITY=Chelmsford
BUSINESS_STATE=MA
BUSINESS_ZIP=
BUSINESS_PHONE=978-758-0690
BUSINESS_EMAIL=eric@murraysgaragedoorservices.com

# ── OPTIONAL: Pricing Defaults ─────────────────────────────────────────
DEFAULT_LABOR_RATE=
DEFAULT_TAX_RATE=
